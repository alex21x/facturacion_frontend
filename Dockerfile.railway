FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=optional
RUN npm i -D @rollup/rollup-linux-x64-musl@4.60.4

COPY . .

RUN npm run build && npm run build:admin

EXPOSE 3000

CMD ["sh", "-lc", "if [ \"${APP_VARIANT:-app}\" = \"admin\" ]; then node scripts/serve-static.mjs dist-admin; else node scripts/serve-static.mjs dist; fi"]