FROM node:22-alpine

WORKDIR /app

ARG VITE_BUILD_MODE=test
ARG VITE_API_BASE_URL
ARG VITE_PUBLIC_APP_URL
ARG VITE_PUBLIC_ADMIN_URL
ARG VITE_REQUEST_TIMEOUT_MS
ARG VITE_AUTH_REQUEST_TIMEOUT_MS
ARG VITE_EXPORT_REQUEST_TIMEOUT_MS
ARG VITE_SLOW_LOOKUP_TIMEOUT_MS
ARG VITE_BULK_IMPORT_TIMEOUT_MS
ARG VITE_SALES_ISSUE_TIMEOUT_MS
ARG VITE_SUNAT_ASYNC_TIMEOUT_MS

COPY package.json package-lock.json ./
RUN npm ci
RUN npm i -D @rollup/rollup-linux-x64-musl@4.60.4

COPY . .

RUN npm run build && npm run build:admin

EXPOSE 3000

CMD ["sh", "-lc", "if [ \"${APP_VARIANT:-app}\" = \"admin\" ]; then node scripts/serve-static.mjs dist-admin; else node scripts/serve-static.mjs dist; fi"]